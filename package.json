{
  "name": "eschars",
  "version": "1.1.0",
  "description": "ESCHARS - native charCodeAt/fromCharCode, bulk byte/unit operations, and modern trim edge scans for Adobe ExtendScript (ES3) via a live-verified ExternalObject DLL",
  "type": "module",
  "main": "dist/eschars-core.esm.mjs",
  "files": [
    "dist/ESCHARS.jsx",
    "dist/ESCHARS.accel.jsx",
    "dist/ESCHARS.accel.min.jsx",
    "dist/ESCHARS.facade.jsx",
    "dist/ESCHARS.manifest.json",
    "dist/eschars-core.esm.mjs",
    "native/SoSharedLibDefs.h",
    "native/eschars.c",
    "native/eschars-cli.c",
    "native/build.ps1",
    "native/bin/ESChars.dll",
    "src/",
    "tests/core-test.mjs",
    "tests/differential.mjs",
    "tests/trim-differential.mjs",
    "tests/eschars-live-verify.mjs",
    "tests/refs.mjs",
    "tests/vectors.mjs",
    "probes/eschars-probe.jsx",
    "probes/eschars-benchmark.jsx",
    "eschars-build.mjs",
    "README.md",
    "RELEASE_NOTES-v1.0.0.md",
    "RELEASE_NOTES-v1.1.0.md",
    "LICENSE",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "node eschars-build.mjs",
    "build:accel": "node eschars-build.mjs --accel",
    "build:native": "powershell -ExecutionPolicy Bypass -File native/build.ps1",
    "test": "node tests/core-test.mjs && node tests/differential.mjs && node tests/trim-differential.mjs",
    "test:trim": "node tests/trim-differential.mjs",
    "typecheck": "npx tsc --noEmit -p .",
    "live-verify": "node tests/eschars-live-verify.mjs",
    "live-verify:fresh": "powershell -Command \"Get-Process Illustrator -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Seconds 3\" && node tests/eschars-live-verify.mjs",
    "benchmark": "python \"../agent-skills/illustrator-com-automation-skill/comtool/ILLUSTRATOR_COM_TOOL.py\" eval --file probes/eschars-benchmark.jsx --launch"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/thelabcorner/es-chars.git"
  },
  "keywords": [
    "charCodeAt",
    "fromCharCode",
    "base64",
    "hex",
    "crc32",
    "fnv1a",
    "externalobject",
    "extendscript",
    "es3",
    "polyfill",
    "illustrator"
  ]
}
